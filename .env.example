# PostgreSQL Database Connection String (Vercel Postgres, Supabase, Neon, Railway, or local PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/skilledhyre_db?schema=public"

# Resend API Key (Required for production email notification delivery)
# Sign up at https://resend.com to generate your API key
RESEND_API_KEY="re_123456789_example_api_key"

# Recipient Email for Team Lead Notifications
PROJECT_INQUIRY_NOTIFICATION_EMAIL="teamskilledhyre@gmail.com"

# Verified Resend Sender Address (e.g. "SkilledHyre Inquiries <onboarding@resend.dev>" or custom domain)
EMAIL_FROM="SkilledHyre Inquiries <onboarding@resend.dev>"
